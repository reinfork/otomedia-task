{
  "expo": {
    "name": "TaskManager",
    "slug": "taskmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "jsEngine": "hermes",
    "updates": { "fallbackToCacheTimeout": 0 },
